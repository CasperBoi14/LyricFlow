# URL of the API backend used for full-track lookup, search, lyrics,
# identification and Spotify token exchange.
# Leave empty when the frontend and API are served from the same origin.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Optional. Spotify Client ID used as the default in the Library view.
# Users can also paste their own Client ID in the app.
VITE_SPOTIFY_CLIENT_ID=

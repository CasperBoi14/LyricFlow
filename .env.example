# URL of the API backend used for full-track lookup, search, lyrics,
# identification and Spotify token exchange.
# Leave empty when the frontend and API are served from the same origin.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Optional. Spotify Client ID used as the default in the Library view.
# Users can also paste their own Client ID in the app.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Free YouTube Data API v3 key. Enables full-length playback in the
# browser without a backend. Users can also paste it in the app under
# "Audio providers"; leave empty to play 30-second iTunes previews.
VITE_YOUTUBE_API_KEY=

# Optional. Free AudD API token. Enables microphone song recognition in the
# browser without a backend. Users can also paste it in the app under
# "Audio providers"; when empty the app asks for a token in the Identify view.
VITE_AUDD_API_TOKEN=

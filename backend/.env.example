# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated list of frontend origins allowed by CORS.
# Use * to allow every origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://casperboi14.github.io

# Maximum request body size in bytes. The identify endpoint accepts base64 WAV audio.
BODY_LIMIT=26214400

# Spotify application credentials used by GET /api/spotify/login and
# POST /api/spotify/token. The Client Secret stays on the server and is never
# returned to the browser.
# Create an app at https://developer.spotify.com/dashboard and add your
# frontend origin as a Redirect URI (for local dev, http://127.0.0.1:5173/).
# Spotify requires HTTPS or a loopback IP, and never accepts `localhost`.
# In-app playback uses the Web Playback SDK and requires Spotify Premium.
# Leave both empty to disable Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

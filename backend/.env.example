# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated list of frontend origins allowed by CORS.
# Use * to allow every origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://casperboi14.github.io

# Maximum request body size in bytes. The identify endpoint accepts base64 WAV audio.
BODY_LIMIT=26214400

# Optional. Official YouTube Data API v3 key.
# When set, GET /api/audio/find prefers the official YouTube Data API.
# When empty, it searches YouTube's public search endpoint directly.
# If YouTube lookup fails, it falls back to a licensed iTunes preview URL.
# Do not commit a real key.
YOUTUBE_API_KEY=

# Spotify application credentials used by POST /api/spotify/token.
# The Client Secret stays on the server and is never returned to the browser.
# Create an app at https://developer.spotify.com/dashboard and add your
# frontend origin as a Redirect URI. Leave both empty to disable the endpoint.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
